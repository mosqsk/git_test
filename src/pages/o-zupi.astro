---
import { getCollection, getEntry, render } from 'astro:content';
import Osnova from '../layouts/Osnova.astro';
import NaslovStranice from '../components/NaslovStranice.astro';
import { postavke } from '../lib/sadrzaj';

const p = await postavke();
const stranica = await getEntry('stranice', 'o-zupi');
if (!stranica) throw new Error('Nedostaje src/content/stranice/o-zupi.md');
const { Content } = await render(stranica);
const s = stranica.data;
const svecenici = await getCollection('svecenici');
const sadasnji = svecenici.filter((x) => x.data.sadasnji).sort((a, b) => (a.data.od ?? 0) - (b.data.od ?? 0));
const prijasnji = svecenici.filter((x) => !x.data.sadasnji).sort((a, b) => (b.data.od ?? 0) - (a.data.od ?? 0));
const godine = (od?: number | null, doG?: number | null) => (od ? `${od}. – ${doG ? doG + '.' : 'danas'}` : '');
---
<Osnova naslov={s.naslov} opis={s.uvod || undefined}>
  <NaslovStranice nadnaslov={p.naziv} naslov={s.naslov} uvod={s.uvod} />

  <section class="omot grid gap-10 py-10 lg:grid-cols-[1.5fr_1fr]">
    <div>
      {s.slika && <img src={s.slika} alt={`Crkva – ${p.naziv}`} class="mb-8 w-full rounded-2xl object-cover" />}
      <div class="proza"><Content /></div>
    </div>

    <aside class="space-y-6">
      {s.zastitnik && (
        <div class="kartica border-t-4 border-t-zlatna">
          <p class="nadnaslov">Zaštitnik župe</p>
          <h2 class="mt-2 text-3xl">{s.zastitnik}</h2>
          {s.dan_proslave && <p class="mt-1 text-lg font-semibold text-akcent">Proslava: {s.dan_proslave}</p>}
          {s.o_zastitniku && <p class="mt-3 text-siva">{s.o_zastitniku}</p>}
        </div>
      )}
      {sadasnji.length > 0 && (
        <div class="kartica">
          <h2 class="text-2xl">Svećenici u župi</h2>
          <ul class="mt-4 space-y-4">
            {sadasnji.map((x) => (
              <li class="flex items-center gap-4">
                {x.data.slika
                  ? <img src={x.data.slika} alt="" class="h-16 w-16 rounded-full object-cover" />
                  : <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-akcent-blijedi font-serif text-xl font-semibold text-akcent">{x.data.ime.replace(/\[.*?\]\s*/, '').split(' ').filter((w) => !/\./.test(w)).map((w) => w[0]).join('').slice(0, 2)}</span>}
                <span><span class="block font-semibold">{x.data.ime}</span><span class="block text-siva">{x.data.sluzba}{x.data.od && `, od ${x.data.od}.`}</span></span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </section>

  {prijasnji.length > 0 && (
    <section class="omot py-6">
      <h2 class="text-3xl">Svećenici koji su služili u župi</h2>
      <ol class="mt-6 border-l-2 border-crta pl-6">
        {prijasnji.map((x) => (
          <li class="relative pb-6 before:absolute before:-left-[1.95rem] before:top-2 before:h-3 before:w-3 before:rounded-full before:bg-zlatna">
            <p class="font-serif text-lg font-semibold tabular-nums text-akcent">{godine(x.data.od, x.data.do)}</p>
            <p class="font-semibold">{x.data.ime} <span class="font-normal text-siva">· {x.data.sluzba}</span></p>
            {x.data.napomena && <p class="text-siva">{x.data.napomena}</p>}
          </li>
        ))}
      </ol>
    </section>
  )}

  {s.galerija.length > 0 && (
    <section class="omot py-10">
      <h2 class="text-3xl">Galerija</h2>
      <ul class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3">
        {s.galerija.map((g) => (
          <li>
            <figure>
              <a href={g.slika} target="_blank" rel="noopener"><img src={g.slika} alt={g.opis || ''} loading="lazy" class="aspect-square w-full rounded-xl object-cover" /></a>
              {g.opis && <figcaption class="mt-1 text-sm text-siva">{g.opis}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}
</Osnova>
