---
import Ikona from './Ikona.astro';
import { postavke } from '../lib/sadrzaj';
interface Props { kompaktno?: boolean }
const { kompaktno = false } = Astro.props;
const p = await postavke();
---
<div class="kartica">
  <div class="flex items-center gap-3">
    <span class="grid h-11 w-11 place-items-center rounded-full bg-akcent-blijedi text-akcent"><Ikona ime="sat" class="h-6 w-6" /></span>
    <h2 class="text-2xl">Svete mise</h2>
  </div>
  <ul class="mt-5 divide-y divide-crta">
    {p.raspored_misa.map((r) => (
      <li data-dani={r.dani.join(' ')} class="-mx-3 rounded-lg px-3 py-3.5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="font-semibold">
            {r.oznaka}
            <span class="danas-znak ml-2 hidden rounded-full bg-zlatna px-2 py-0.5 align-middle text-xs font-bold uppercase tracking-wide text-white">Danas</span>
          </p>
          <p class="font-serif text-xl font-semibold tabular-nums text-akcent">{r.vremena.join(' · ')}</p>
        </div>
        {r.napomena && !kompaktno && <p class="mt-1 text-[0.95rem] text-siva">{r.napomena}</p>}
      </li>
    ))}
  </ul>
</div>
